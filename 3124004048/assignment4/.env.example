# ============================================================
# 智能待办管理 Agent —— 环境变量模板
# 使用方法：复制本文件为 .env，填入真实值（.env 已被 .gitignore 排除）
# ============================================================

# --- DeepSeek API（必填）---
# 申请地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=60
DEEPSEEK_MAX_RETRIES=2

# --- Agent 行为 ---
# 单轮对话内允许的最大「模型思考 + 工具调用」轮次，防止死循环
AGENT_MAX_TURNS=8
# 注入给模型的最短记忆：最近 N 轮原始对话
MEMORY_RECENT_TURNS=8
# 超过该条数时触发历史摘要压缩
MEMORY_SUMMARY_THRESHOLD=24

# --- 存储与外部服务 ---
TODO_DB_PATH=.data/todo.db
DEFAULT_CITY=北京
WEATHER_TIMEOUT=10

# --- Web 服务 ---
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- MCP ---
# 备选：如希望改用已安装到 PATH 的 mcp 命令，可在此指定启动命令
MCP_SERVER_COMMAND=

# ============================================================
# 语音输入 / 输出（加分项④）
# 走 Windows 内置的 SAPI 引擎，完全离线运行，**不需要任何密钥、不下载模型**。
# 只需系统已安装中文语音引擎即可（简体中文版 Windows 默认自带）。
# 可用 `python scripts/voice_smoke.py` 一键检测本机是否支持。
# ============================================================
VOICE_ENABLED=true

# --- 识别引擎选择（关键项）---
# auto    = 优先 faster-whisper（高精度），依赖或模型不可用时自动回退系统 SAPI
# whisper = 强制使用 faster-whisper，不可用则整体禁用语音输入
# sapi    = 强制使用 Windows 自带引擎（零依赖，但精度明显较低）
# 答辩现场可用它做"基础 vs 高精度"的效果对比。
VOICE_STT_PROVIDER=auto

# --- faster-whisper 参数（VOICE_STT_PROVIDER=auto/whisper 时生效）---
# 模型规格：tiny / base / small / medium / large-v3
#   base  ≈ 145MB，最快
#   small ≈ 480MB，速度与准确率平衡（推荐）
#   medium ≈ 1.5GB，更准但更慢
# 预下载：python scripts/download_asr_model.py --model small
VOICE_WHISPER_MODEL=small
# cpu 或 cuda（cuda 需要本机有可用的 CUDA 运行库，否则会自动报错）
VOICE_WHISPER_DEVICE=cpu
# int8 最快且内存占用最低；CPU 上建议保持 int8
VOICE_WHISPER_COMPUTE_TYPE=int8
# 模型下载源。默认国内镜像（huggingface.co 在部分网络下不可达）；
# 留空则使用官方源，也可自行指定其他镜像。
VOICE_WHISPER_ENDPOINT=https://hf-mirror.com
# 模型存放目录，留空 = .data/models/whisper
VOICE_WHISPER_ROOT=

# --- SAPI 参数（回退或强制 sapi 时生效）---
# 留空 = 自动挑选中文识别引擎 / 中文音色
VOICE_SAPI_ENGINE=
VOICE_TTS_VOICE=

# auto   = 自由听写 + 受限指令短语（推荐，兼顾灵活与准确）
# commands = 只识别下面指令清单里的说法，准确率最高但只能用固定句式
VOICE_ASR_MODE=auto

# 识别结果是否交给大模型纠错（需要 DEEPSEEK_API_KEY；未配置密钥时会自动跳过）
VOICE_ASR_CORRECT=true

# 语速 -10(慢) ~ 10(快)，音量 0~100
VOICE_TTS_RATE=0
VOICE_TTS_VOLUME=100

# 单次朗读的字符上限（超出截断），避免一次念完整篇简报
VOICE_TTS_MAX_CHARS=800

# 识别完成后是否自动发送（false 则只填入输入框，由用户确认后再发）
VOICE_AUTO_SEND=true
# 助理回复是否默认自动朗读（前端也可在界面上切换）
VOICE_AUTO_READ=false
# 录音结束后是否自动回放一遍自己的录音（默认开启，便于确认"录进去的声音"是否正常；
# 前端界面上的「录音后回放」开关会覆盖此默认值并记住用户选择）
VOICE_AUTO_REPLAY=true
# 单次录音时长上限（秒）
VOICE_MAX_SECONDS=15
# 语音引擎单次调用超时（秒）
VOICE_TIMEOUT=25
# 合成结果磁盘缓存条数上限
VOICE_CACHE_SIZE=40
